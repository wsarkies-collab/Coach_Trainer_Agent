# .env.example likely got skipped by GitHub's drag-and-drop upload (it silently
# drops dotfiles from some OS file pickers) — recreated here from the README/code.
# Copy to .env for local testing; .env is gitignored, never commit real secrets.

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Supabase (leave both unset to run on demo/app-data.json locally) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- healthandfitness has no Supabase Auth yet, so these can't be filled in ---
# See the note in chat — every /api/* endpoint requires a real Supabase Auth
# user (agent/auth.js's identifyUser), independent of these settings. Until
# that exists, leave PROFILE_TABLE/WORKOUTS_* unset; nothing reads them anyway
# because requireUser() rejects the request before appData.js ever runs.
# PROFILE_TABLE=settings
# PROFILE_USER_COLUMN=
# WORKOUTS_TABLE=settings
# WORKOUTS_USER_COLUMN=
# WORKOUTS_DATE_COLUMN=
# WORKOUTS_SELECT=

# --- Exercise videos: already match healthandfitness's exercise_videos table
# defaults exactly, so these can stay unset. Uncomment only if you rename
# the table/columns later. ---
# EXERCISE_VIDEOS_TABLE=exercise_videos
# EXERCISE_VIDEOS_NAME_COLUMN=exercise
# EXERCISE_VIDEOS_URL_COLUMN=url
# EXERCISE_VIDEOS_TITLE_COLUMN=title
# EXERCISE_VIDEOS_ALIASES_COLUMN=aliases
VIDEO_FALLBACK=none
# YOUTUBE_API_KEY=

# --- App identity shown in the coach's own system prompt ---
APP_NAME=your gym app
COACH_NAME=Coach

# --- Deploy-time ---
# Guessed from the repo name — replace with your actual Vercel URL for this app.
ALLOWED_ORIGINS=https://healthandfitness.vercel.app
RATE_LIMIT_PER_MIN=6
DAILY_MESSAGE_LIMIT=50
